{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.execsam.claude-usage",
	"Name": "Claude Usage Meter",
	"Version": "1.0.0.0",
	"Author": "ExecSam",
	"Description": "Live Claude & Claude Code usage limits on your Stream Deck — session and weekly limits, per-model caps, reset countdowns and burn-rate pace. Colour-coded, animated and auto-refreshing. No Claude app required.",
	"Icon": "imgs/plugin/marketplace",
	"Category": "Claude Usage Meter",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"URL": "https://github.com/ExecSam/streamdeck-cc",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"Name": "Usage Gauge",
			"UUID": "com.execsam.claude-usage.gauge",
			"Icon": "imgs/actions/gauge/icon",
			"Tooltip": "One Claude limit (session, weekly or per-model) as a live gauge. Press to refresh, hold to switch limit.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/gauge/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Usage Overview",
			"UUID": "com.execsam.claude-usage.overview",
			"Icon": "imgs/actions/overview/icon",
			"Tooltip": "All your Claude limits at a glance. Works on keys and on Stream Deck + dials.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/overview/key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "layouts/strip.json",
				"Icon": "imgs/actions/overview/icon",
				"StackColor": "#D97757",
				"TriggerDescription": {
					"Rotate": "Switch limit",
					"Push": "Refresh now",
					"Touch": "Refresh now",
					"LongTouch": "Open claude.ai usage"
				}
			}
		}
	]
}